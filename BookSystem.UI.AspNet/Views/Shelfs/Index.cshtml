@model IEnumerable<BookSystem.Model.Shelf>
@{
    ViewData["Title"] = "Moja Wirtualna Półka";
}

<h2 class="text-center mb-4">Moja Wirtualna Półka</h2>

@if (Model != null && Model.Any())
{
    <div class="table-beige-wrapper shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-beige">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 75px;">Okładka</th>
                        <th>Książka</th>
                        <th>Autor</th>
                        <th>Status</th>
                        <th class="text-center">Ulubiona</th>
                        <th class="text-end pe-3">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 py-2">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId">
                                    <img src="@(item.Book?.CoverUrl?.Replace("-L.jpg", "-S.jpg") ?? Url.Content("~/images/no-cover.svg"))"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/images/no-cover.svg")'"
                                         alt="Okładka: @(item.Book?.Title)" class="book-cover" style="max-width: 45px;" loading="lazy" />
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" class="text-decoration-none fw-bold" style="color: var(--text-dark);">
                                    @(item.Book?.Title)
                                </a>
                            </td>
                            <td>@(item.Book?.Author?.FirstName) @(item.Book?.Author?.LastName)</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case BookSystem.Model.ShelfStatus.PlanToRead:
                                        <span class="badge" style="background-color: #d8c8b0; color: var(--text-dark);">W planach</span>
                                        break;
                                    case BookSystem.Model.ShelfStatus.Reading:
                                        <span class="badge" style="background-color: var(--accent-brown);">W trakcie czytania</span>
                                        break;
                                    case BookSystem.Model.ShelfStatus.Read:
                                        <span class="badge" style="background-color: #5c7a52;">Przeczytane</span>
                                        break;
                                    default:
                                        <span class="text-muted">-</span>
                                        break;
                                }
                            </td>
                            <td class="text-center fs-5">
                                @if (item.IsFavourite)
                                {
                                    <span style="color: #d49b27;" title="Ulubiona">★</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <form asp-action="RemoveFromShelf" method="post" class="d-inline">
                                    <input type="hidden" name="bookId" value="@item.BookId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm text-center p-4" style="background-color: var(--card-bg); border-color: var(--border-beige);">
        <h5 class="mb-2">Twoja półka jest jeszcze pusta</h5>
        <p class="text-muted mb-3">Przejdź do katalogu, aby odkryć i dodać książki do swojej kolekcji.</p>
        <div>
            <a asp-controller="Books" asp-action="Index" class="btn btn-beige btn-sm">Przejdź do Katalogu Książek</a>
        </div>
    </div>
}