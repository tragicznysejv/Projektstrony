@model BookSystem.Model.Author
@{
    ViewData["Title"] = $"Szczegóły autora: {Model.FirstName} {Model.LastName}";
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">@Model.FirstName @Model.LastName</h3>
    </div>
    <div class="card-body">
        <h4 class="card-title mb-3">Książki tego autora:</h4>
        @if (Model.Books != null && Model.Books.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var book in Model.Books)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>
                            <strong>@book.Title</strong> <span class="text-muted">(ISBN: @book.ISBN)</span>
                        </span>
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary">Zobacz książkę</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Ten autor nie ma przypisanych żadnych książek w systemie.</p>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Powrót do listy autorów</a>
    </div>
</div>