@model BookSystem.Model.Author
@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
}

<div class="text-center mb-4 pb-3 border-bottom" style="border-color: var(--border-beige) !important;">
    <h2 class="display-5 mb-2">@Model.FirstName @Model.LastName</h2>
    <p class="text-muted mb-0">Książki tego autora w naszej bibliotece</p>
</div>

@if (Model.Books != null && Model.Books.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
        @foreach (var book in Model.Books)
        {
            <div class="col">
                <div class="card h-100 shadow-sm book-card">
                    <div class="text-center pt-4 px-3">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">
                            <img src="@(book.CoverUrl?.Replace("-L.jpg", "-M.jpg") ?? Url.Content("~/images/no-cover.svg"))"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/no-cover.svg")'"
                                 alt="Okładka: @book.Title" class="book-cover" loading="lazy" />
                        </a>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title mb-1">@book.Title</h5>
                        <p class="card-text small text-muted mb-1">
                            Wydano: @book.PublishDate.ToShortDateString()
                        </p>
                        <p class="card-text small text-muted mb-0">
                            ISBN: @book.ISBN
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pb-3 px-3">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-beige-outline btn-sm w-100">
                            Szczegóły
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center my-5">
        <p class="text-muted">Ten autor nie ma jeszcze przypisanych żadnych książek w systemie.</p>
    </div>
}

<div class="text-center mb-4">
    <a asp-action="Index" class="btn btn-beige-secondary">Powrót do listy autorów</a>
</div>