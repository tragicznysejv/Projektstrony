@model BookSystem.Model.Book
@{
    ViewData["Title"] = Model.Title;
}

<div class="row mt-3">
    <!-- Główna sekcja: Okładka, informacje o książce i recenzje -->
    <div class="col-md-8">
        <div class="card shadow-sm mb-4" style="background-color: var(--card-bg); border-color: var(--border-beige);">
            <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--nav-beige); border-bottom-color: var(--border-beige);">
                <h3 class="mb-0" style="color: var(--text-dark);">@Model.Title</h3>
                <span class="badge" style="background-color: var(--accent-brown);">Wydano: @Model.PublishDate.Year</span>
            </div>
            <div class="card-body">
                <div class="row g-4 align-items-start">
                    <!-- Duża okładka -->
                    <div class="col-sm-4 text-center">
                        <img src="@(Model.CoverUrl ?? Url.Content("~/images/no-cover.svg"))"
                             onerror="this.onerror=null;this.src='@Url.Content("~/images/no-cover.svg")'"
                             alt="Okładka: @Model.Title" class="book-cover book-cover-lg" />
                    </div>

                    <!-- Szczegóły i opis -->
                    <div class="col-sm-8">
                        <h5 class="mb-2">
                            Autor:
                            <a asp-controller="Authors" asp-action="Details" asp-route-id="@Model.AuthorId" class="text-decoration-none" style="color: var(--accent-brown);">
                                @(Model.Author?.FirstName) @(Model.Author?.LastName)
                            </a>
                        </h5>
                        <p class="mb-1 small text-muted"><strong>ISBN:</strong> @Model.ISBN</p>
                        <p class="mb-3 small text-muted"><strong>Data wydania:</strong> @Model.PublishDate.ToShortDateString()</p>
                        <hr style="border-color: var(--border-beige);" />
                        <h6>Opis:</h6>
                        <p class="card-text">
                            @(string.IsNullOrEmpty(Model.Description) ? "Brak opisu dla tej książki." : Model.Description)
                        </p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent" style="border-top-color: var(--border-beige);">
                <a asp-action="Index" class="btn btn-beige-secondary btn-sm">Wróć do katalogu</a>
            </div>
        </div>

        <!-- Sekcja recenzji i komentarzy -->
        <div class="card shadow-sm mb-4" style="background-color: var(--card-bg); border-color: var(--border-beige);">
            <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--nav-beige); border-bottom-color: var(--border-beige);">
                <h4 class="mb-0" style="color: var(--text-dark);">Recenzje i Komentarze</h4>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Comments" asp-action="Create" asp-route-bookId="@Model.BookId" class="btn btn-beige btn-sm">Dodaj recenzję</a>
                }
            </div>
            <div class="card-body">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="alert py-2 mb-3" style="background-color: var(--bg-beige); border: 1px solid var(--border-beige);">
                        <a asp-area="Identity" asp-page="/Account/Login" class="fw-bold text-decoration-none" style="color: var(--accent-brown);">Zaloguj się</a>, aby dodać komentarz.
                    </div>
                }

                @if (Model.Comments != null && Model.Comments.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var comment in Model.Comments.OrderByDescending(c => c.PublishDate))
                        {
                            <li class="list-group-item bg-transparent px-0" style="border-color: var(--border-beige);">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">@(comment.Title ?? "Recenzja")</h6>
                                    <small class="text-muted">@comment.PublishDate.ToString("g")</small>
                                </div>
                                <p class="mb-2">@comment.Description</p>
                                <span class="badge" style="background-color: var(--accent-brown);">Ocena: @comment.Rating / 5</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Ta książka nie ma jeszcze żadnych recenzji.</p>
                }
            </div>
        </div>
    </div>

    <!-- Panel boczny: Wirtualna Półka -->
    <div class="col-md-4">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card shadow-sm" style="background-color: var(--card-bg); border-color: var(--border-beige);">
                <div class="card-header" style="background-color: var(--nav-beige); border-bottom-color: var(--border-beige);">
                    <h5 class="mb-0" style="color: var(--text-dark);">Zarządzaj Półką</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Shelfs" asp-action="UpdateShelf" method="post">
                        <input type="hidden" name="bookId" value="@Model.BookId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Status czytania:</label>
                            <select name="status" class="form-select">
                                <option value="">Wybierz status...</option>
                                <option value="PlanToRead">W planach</option>
                                <option value="Reading">W trakcie czytania</option>
                                <option value="Read">Przeczytane</option>
                            </select>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" name="isFavourite" value="true" id="favCheck">
                            <label class="form-check-label" for="favCheck">Dodaj do ulubionych</label>
                        </div>

                        <button type="submit" class="btn btn-beige w-100 mb-2">Zapisz na półce</button>
                    </form>

                    <form asp-controller="Shelfs" asp-action="RemoveFromShelf" method="post">
                        <input type="hidden" name="bookId" value="@Model.BookId" />
                        <button type="submit" class="btn btn-outline-danger w-100">Usuń z półki</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm" style="background-color: var(--card-bg); border-color: var(--border-beige);">
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Zaloguj się, aby dodać tę książkę do swojej półki.</p>
                </div>
            </div>
        }
    </div>
</div>