@model IEnumerable<BookSystem.Model.Book>
@{
    ViewData["Title"] = "Katalog Książek";
}

<h2 class="mb-4">Katalog Książek</h2>

<form asp-action="Index" method="get" class="d-flex mb-4">
    <input type="text" name="searchString" class="form-control me-2" placeholder="Szukaj po tytule lub nazwisku autora..." value="@Context.Request.Query["searchString"]" />
    <button type="submit" class="btn btn-primary">Szukaj</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Wyczyść</a>
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tytuł</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Data wydania</th>
            <th class="text-end">Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td><strong>@book.Title</strong></td>
                <td>@(book.Author?.FirstName) @(book.Author?.LastName)</td>
                <td>@book.ISBN</td>
                <td>@book.PublishDate.ToShortDateString()</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-info btn-sm text-white">Szczegóły</a>
                </td>
            </tr>
        }
    </tbody>
</table>